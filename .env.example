# Environment Variables for CODESTORM
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---- Google Apps Script Registration Backend ----
# The master database is Google Sheets via Google Apps Script Web App
# Follow GOOGLE_SHEETS_SETUP.md to obtain your Web App URL:
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# ---- Optional Direct Google Sheets API (for Vercel Serverless / Service Account) ----
# If using a Google Cloud Service Account instead of / in addition to Apps Script:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=your_google_spreadsheet_id
# GOOGLE_SHEET_NAME=Registrations

# ---- CodeStorm Event Conducting Platform ----
# URL of the competition platform where participants log in using their Participant ID & password:
VITE_EVENT_PLATFORM_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# ---- Optional Express / MongoDB Server (If running local backend) ----
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codestorm?retryWrites=true&w=majority
ADMIN_SECRET=change_this_to_a_strong_random_string
CLIENT_URL=http://localhost:5173
